<!--
***********************************************************************************************
Samsung.Tizen.Ref.API15.proj

This project file is used to create the Samsung.Tizen.Ref.API15 NuGet, which is the
targeting pack containing reference assemblies and other compile time assets required
by projects that use the Tizen .NET framework in .NET 5.
***********************************************************************************************
-->
<Project Sdk="Microsoft.Build.NoTargets">

  <!-- API15 ships ref assemblies under ref/net8.0/ (same as API14).
       Override Directory.Build.props default of net6.0. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <TizenFXAPILevel>$(TizenFXAPI15Version.Split(".")[0])</TizenFXAPILevel>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Samsung.Tizen.Ref.API15</PackageId>
    <Description>
      Tizen .NET reference assemblies. Please do not reference directly.
      - TizenFX API Level : $(TizenFXAPILevel)
      - TizenFX Version : $(TizenFXAPI15Version)
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TizenFXPackageName>Tizen.NET.API$(TizenFXAPILevel)</TizenFXPackageName>
    <TizenFXNuGetPathVariable>PkgTizen_NET_API$(TizenFXAPILevel)</TizenFXNuGetPathVariable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(TizenFXPackageName)" Version="$(TizenFXAPI15Version)" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <BeforePack>
      _GetPackageVersion;
      _GetTargetingPackItems;
      _GenerateFrameworkListFile;
      $(BeforePack);
    </BeforePack>
  </PropertyGroup>

  <Target Name="_GetTargetingPackItems"
      DependsOnTargets="_GetLicense">
    <PropertyGroup>
      <FrameworkListFile>$(IntermediateOutputPath)FrameworkList.xml</FrameworkListFile>
    </PropertyGroup>

    <ItemGroup>
      <_TizenFXNugetPathItem Include="$(TizenFXNuGetPathVariable)" />
      <!-- Tizen.NET.API* packages have shipped their reference assemblies under ref/net8.0/
           (e.g. Tizen.NET.API14 14.0.0.19368, Tizen.NET.API15) or under ref/net6.0/ (Tizen.NET.API11-13,
           Tizen.NET.API14 up to 14.0.0.19302). Globbing one fixed folder is how Samsung.Tizen.Ref.API14
           14.0.0.19300/19301 shipped empty. Take ref/net8.0 when it has assemblies, else ref/net6.0; the
           produced pack always lays them out under ref/net8.0 (see _PackageFiles below). -->
      <_TizenRefPackAssemblies Include="$(%(_TizenFXNugetPathItem.Identity))\ref\net8.0\*.dll" />
      <_TizenRefPackAssemblies Include="$(%(_TizenFXNugetPathItem.Identity))\ref\net6.0\*.dll" Condition="'@(_TizenRefPackAssemblies)' == ''" />
      <FrameworkListFileClass Include="@(_TizenRefPackAssemblies->'%(Filename)%(Extension)')" Profile="Tizen" />
    </ItemGroup>

    <!-- An empty glob silently produced a reference pack with no assemblies (Samsung.Tizen.Ref.API14
         14.0.0.19300 and 14.0.0.19301 on nuget.org). Fail the pack instead. -->
    <Error Condition="'@(_TizenRefPackAssemblies)' == ''"
           Text="$(TizenFXPackageName) $(TizenFXAPI15Version): no reference assemblies matched the ref/ glob in $(TizenFXNuGetPathVariable); the pack would ship empty." />

    <ItemGroup>
      <_PackageFiles Include="@(_TizenRefPackAssemblies)" PackagePath="ref\net8.0" TargetPath="ref\net8.0" />
      <_PackageFiles Include="$(_ProjectSourceDirectory)Samsung.Tizen.Ref/data/*.txt" PackagePath="data" />
      <_PackageFiles Include="$(_ProjectSourceDirectory)Samsung.Tizen.Ref/runtime.json" PackagePath=".\" />
    </ItemGroup>

  </Target>

  <UsingTask TaskName="CreateFrameworkListFile" AssemblyFile="$(DotNetSharedFrameworkTaskFile)"/>

  <!-- https://github.com/dotnet/runtime/blob/0647ec314948904319da5eb15e9931f7c85ed1e2/src/installer/pkg/projects/Directory.Build.targets#L281 -->
  <Target Name="_GenerateFrameworkListFile" >
    <!-- Hardcode framework attributes -->
    <ItemGroup>
      <FrameworkListRootAttributes Include="Name" Value=".NET 10.0 - Tizen" />
      <FrameworkListRootAttributes Include="TargetFrameworkIdentifier" Value=".NETCoreApp" />
      <FrameworkListRootAttributes Include="TargetFrameworkVersion" Value="10.0" />
      <FrameworkListRootAttributes Include="FrameworkName" Value="Samsung.Tizen" />
    </ItemGroup>

    <!-- https://github.com/dotnet/arcade/blob/5824baf1c9a900ee00c167f96201c750bba6a574/src/Microsoft.DotNet.SharedFramework.Sdk/src/CreateFrameworkListFile.cs -->
    <CreateFrameworkListFile
        Files="@(_PackageFiles)"
        FileClassifications="@(FrameworkListFileClass)"
        TargetFile="$(FrameworkListFile)"
        TargetFilePrefixes="ref;runtimes"
        RootAttributes="@(FrameworkListRootAttributes)"
    />
    <ItemGroup>
      <_PackageFiles Include="$(FrameworkListFile)" PackagePath="data" />
    </ItemGroup>
  </Target>

</Project>
